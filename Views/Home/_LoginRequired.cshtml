@model PortalViewModel

<section class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <h2 class="h4 mb-3">Customer access required</h2>
        <p class="mb-2">Request an OTP for the customer mobile number, verify the code, and the portal will load:</p>
        <ul class="mb-0">
            <li>the CRM customer profile from the configured <code>get_customer_profile</code> operation</li>
            <li>the BRM token and dashboard service-instance list for the customer account</li>
            <li>the CRM <code>ServiceInstanceAccount</code> records used to resolve line MSISDN values</li>
        </ul>
    </div>
</section>
