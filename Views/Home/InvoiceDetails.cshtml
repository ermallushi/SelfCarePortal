@model InvoiceSummary
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceId}";
}

<section class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-1">Invoice @Model.InvoiceId</h1>
                <p class="text-muted mb-0">Billing period: @Model.BillingPeriod</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to portal</a>
                <a asp-action="InvoicePdf" asp-route-id="@Model.InvoiceId" class="btn btn-primary">Download PDF</a>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
            <div class="col"><div class="detail-card"><span>Status</span><strong>@Model.Status</strong></div></div>
            <div class="col"><div class="detail-card"><span>Due date</span><strong>@Model.DueDate.ToString("dd MMM yyyy")</strong></div></div>
            <div class="col"><div class="detail-card"><span>Total amount</span><strong>ALL @Model.TotalAmount.ToString("N0")</strong></div></div>
        </div>
        <h2 class="h5">Statement lines</h2>
        <ul class="list-group list-group-flush">
            @foreach (var line in Model.StatementLines)
            {
                <li class="list-group-item px-0">@line</li>
            }
        </ul>
    </div>
</section>
