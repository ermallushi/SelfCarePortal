@model PortalViewModel
@{
    ViewData["Title"] = "ONE Business Portal";
}

<section class="hero-card mb-4">
    <div class="d-lg-flex justify-content-between align-items-start gap-4">
        <div>
            <span class="text-uppercase portal-kicker">Unified enterprise self-care</span>
            <h1 class="display-5 fw-bold mb-3">ONE Business Portal</h1>
            <p class="lead mb-4">A .NET Core MVC front door for business customers to authenticate with mobile OTP, while CAM users are governed by Active Directory access in the <strong>@Model.AccessSummary.ActiveDirectoryDomain</strong> domain.</p>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-primary-subtle text-primary-emphasis">Customer SMS OTP</span>
                <span class="badge bg-info-subtle text-info-emphasis">CAM AD domain: @Model.AccessSummary.ActiveDirectoryDomain</span>
                <span class="badge bg-success-subtle text-success-emphasis">Auto provisioning: @(Model.AccessSummary.AutoProvisionUsers ? "enabled" : "disabled")</span>
            </div>
        </div>
        <div class="auth-summary card shadow-sm border-0 mt-4 mt-lg-0">
            <div class="card-body">
                <h2 class="h5">Authentication & access</h2>
                <p class="small text-muted mb-2"><strong>Customers:</strong> @Model.AccessSummary.CustomerLoginMethod</p>
                <p class="small text-muted mb-3"><strong>CAM / staff:</strong> @Model.AccessSummary.StaffLoginMethod</p>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var role in Model.AccessSummary.Roles)
                    {
                        <span class="badge rounded-pill text-bg-light border">@role</span>
                    }
                </div>

                @if (Model.Authentication.IsCustomerAuthenticated)
                {
                    <div class="detail-card compact-card mb-3">
                        <span>Authenticated customer</span>
                        <strong>@Model.Authentication.AuthenticatedMobileNumber</strong>
                    </div>
                    <form asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">Log out</button>
                    </form>
                }
                else
                {
                    <form asp-action="SendOtp" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <label class="form-label" for="MobileNumber">Customer mobile number</label>
                        <div class="input-group">
                            <input class="form-control" id="MobileNumber" name="MobileNumber" value="@Model.Authentication.PendingOtpMobileNumber" placeholder="355672017758" />
                            <button type="submit" class="btn btn-primary">Send OTP</button>
                        </div>
                    </form>

                    @if (Model.Authentication.HasPendingOtpChallenge && !string.IsNullOrWhiteSpace(Model.Authentication.PendingOtpMobileNumber))
                    {
                        <form asp-action="VerifyOtp" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="MobileNumber" value="@Model.Authentication.PendingOtpMobileNumber" />
                            <label class="form-label" for="OtpCode">OTP code</label>
                            <div class="input-group">
                                <input class="form-control" id="OtpCode" name="OtpCode" placeholder="Enter the code received by SMS" />
                                <button type="submit" class="btn btn-outline-primary">Verify</button>
                            </div>
                            <div class="form-text">Verifies the OTP sent to @Model.Authentication.PendingOtpMobileNumber and starts the CRM-backed customer session.</div>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.BannerMessage))
{
    <div class="alert alert-@Model.BannerTone alert-dismissible fade show" role="alert">
        @Model.BannerMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Authentication.IsCustomerAuthenticated)
{
    @await Html.PartialAsync("_AuthenticatedPortal", Model)
}
else
{
    @await Html.PartialAsync("_LoginRequired", Model)
}
